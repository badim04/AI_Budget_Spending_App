{
  "name": "finlo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Multi-currency budget and spending tracker for Android, iOS and web, with receipt/email auto-capture and forecasting.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "apk": "eas build --profile preview --platform android",
    "apk:local": "eas build --profile preview --platform android --local",
    "ios:build": "eas build --profile preview --platform ios",
    "push": "eas update --branch preview --message",
    "push:prod": "eas update --branch production --message",
    "release": "eas build --profile production --platform android",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.27.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  }
}
