# Copy to .env and fill in what you want. .env is gitignored.
# Finlo runs fully without any of these — they only switch on automatic capture.
# Step-by-step instructions: docs/SHIPPING.md

EXPO_PUBLIC_APP_ENV=development

# --- Receipt OCR (optional, free) -------------------------------------------
# Free key by email from https://ocr.space/ocrapi  (25k requests/month)
# Without it: receipts are stored, attached and searchable; you type the amount.
EXPO_PUBLIC_OCR_API_KEY=

# --- Gmail import (optional, free) ------------------------------------------
# One OAuth client id per platform, from your own Google Cloud project.
# console.cloud.google.com -> enable Gmail API -> Credentials -> OAuth client ID
# Android package / iOS bundle id: com.badim04.finlo
# Web redirect URI: http://localhost:8081
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# --- AI categorisation ------------------------------------------------------
# SAFE (recommended before sharing an APK): point at your own proxy, which holds
# the Gemini key server-side. See server/llm-proxy/README.md — free, ~3 minutes.
EXPO_PUBLIC_LLM_PROXY_URL=
EXPO_PUBLIC_LLM_PROXY_TOKEN=

# UNSAFE for wide distribution: the key is compiled into the APK and anyone who
# unzips it can read it. Fine while only you have the build. The proxy above
# wins whenever it is set, so you can leave this filled in during development.
EXPO_PUBLIC_GEMINI_API_KEY=

# --- FX rates ---------------------------------------------------------------
EXPO_PUBLIC_FX_API_URL=https://api.exchangerate.host

# NOTE: EXPO_PUBLIC_* values are embedded in the app bundle and readable by
# anyone who unpacks the APK. Fine for a rate-limited free OCR key and for
# OAuth client ids (which Google treats as public). Never put a payment,
# banking or admin secret behind that prefix — those belong on a server.
